# ============================================================
# Python - file yang tidak boleh masuk repo
# ============================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
MANIFEST
.eggs/

# Virtual environment (dibuat ulang lewat `python -m venv .venv`)
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Pytest & coverage cache
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.tox/
.nox/

# Linting / type-checking cache
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json

# Riwayat lokal CryptoLab (tidak boleh di-commit: berisi jejak operasi)
.cryptolab_history/

# ============================================================
# Editor & OS
# ============================================================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# Lokal / sementara
# ============================================================
*.log
*.sqlite
*.sqlite3
*.db
.env
.env.*
!.env.example
